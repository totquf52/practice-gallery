# 열쇠 값(남이 보면 안 되는 비밀 번호 같은 값)이 들어 있는 파일
.env

# 파이썬이 실행할 때 저절로 만드는 파일 (다시 만들어지므로 둘 필요 없음)
__pycache__/
*.pyc

# 내 컴퓨터에서만 쓰는 Claude 설정
.claude/settings.local.json

# 파이썬 꾸러미를 따로 깔아 두는 폴더 (지금은 없지만 생기면 뺀다)
.venv/
venv/

# Streamlit 열쇠 값 파일 (지금은 없지만 생기면 뺀다)
.streamlit/secrets.toml

# 윈도가 저절로 만드는 파일
Thumbs.db
desktop.ini
